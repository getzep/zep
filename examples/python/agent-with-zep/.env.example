# Required: Zep Cloud API key (https://app.getzep.com)
ZEP_API_KEY=

# Graph UUID printed by ingest
GRAPH_UUID=

# Optional: v4 uses this URL as given. Include /api/v4.
# Example: https://api.getzep.com/api/v4
ZEP_BASE_URL=

# Pydantic AI model strings, e.g. openai:gpt-6-luna, anthropic:claude-sonnet-5-5,
# google-gla:gemini-3.8-flash. The provider API key env var must be set too
# (OPENAI_API_KEY, ANTHROPIC_API_KEY, GEMINI_API_KEY, ...).
AGENT_MODEL=openai:gpt-6-luna
JUDGE_MODEL=openai:gpt-6-luna

# Thinking level for the agent and the judge. One of minimal, low, medium,
# high, or xhigh. The default is low.
MODEL_THINKING=low

# Provider keys (set the ones your models need)
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
