# Required: Zep Cloud API key (https://app.getzep.com)
ZEP_API_KEY=

# Graph that holds the Pemberline Medical demo data
GRAPH_ID=pemberline-demo

# Optional: Zep API base URL. The default is Zep Cloud.
ZEP_BASE_URL=

# LiteLLM model strings use provider/model format.
# Set the matching provider key, such as OPENAI_API_KEY or ANTHROPIC_API_KEY.
AGENT_MODEL=openai/gpt-6-luna
JUDGE_MODEL=openai/gpt-6-luna

# Google ADK accepts GOOGLE_API_KEY for Gemini models.
# If your key is named GEMINI_API_KEY, set GOOGLE_API_KEY to the same value.
GOOGLE_API_KEY=
# GEMINI_API_KEY=

# Example models: openai/gpt-6-luna, anthropic/claude-sonnet-5-5,
# gemini-3.5-flash.

# Thinking level for the agent and the judge. One of minimal, low, medium,
# high, or xhigh. Gemini does not support xhigh. The default is low.
MODEL_THINKING=low

# Provider keys (set the ones your models need)
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
