  "dependencies": {
    "@ai-sdk/google": "^4.0.41",
    "@getzep/zep-cloud": "^3.27.0",
    "@vercel/connect": "0.4.3",
    "ai": "^7.0.58",
    "dotenv": "^17.4.2",
    "eve": "^0.32.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "microsandbox": "^0.5.10",
    "tsx": "^4.20.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "ai": "^7.0.58"
  },
  "engines": {
    "node": ">=24"
  }
