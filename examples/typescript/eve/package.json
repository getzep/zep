{
  "name": "zep-eve-example",
  "version": "0.1.0",
  "private": true,
  "description": "Working example: Zep Cloud long-term memory wired into a Vercel Eve agent",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "dev": "eve dev",
    "start": "eve start",
    "typecheck": "tsc",
