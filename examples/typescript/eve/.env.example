# Zep Cloud
ZEP_API_KEY=

# Application identity label when Eve auth is not configured.
# The app stores Zep-returned UUIDs in .data/zep-identities.json.
ZEP_DEMO_USER_ID=eve-demo-user
ZEP_DEMO_USER_NAME=Demo User
ZEP_IDENTITY_FILE=.data/zep-identities.json

# Set this to the UUID printed by `npm run seed:company`.
ZEP_COMPANY_GRAPH_UUID=

# Eve / Vercel AI Gateway (only needed if you switch agent.ts to a gateway model id)
AI_GATEWAY_API_KEY=

# Google Gemini — used directly via @ai-sdk/google in agent.ts
GOOGLE_API_KEY=
